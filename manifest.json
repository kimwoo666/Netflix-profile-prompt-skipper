{
  "manifest_version": 3,
  "name": "Netflix Profile Prompt Skipper",
  "version": "1.0.1",
  "description": "넷플릭스의 프로필 이메일 추가 안내창을 자동으로 숨기고 화면 잠금을 해제합니다.",
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
